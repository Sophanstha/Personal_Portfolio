# Copy to .env.local and fill in. Never commit .env.local.

# Contact form email (https://resend.com → API Keys → Create API key)
RESEND_API_KEY=

# Optional. Where enquiries go (defaults to the email in src/content/site.ts).
# On Resend's free plan without a verified domain this must be the address
# you signed up to Resend with.
CONTACT_TO=

# Optional. Sender, once you've verified your own domain in Resend,
# e.g. "Sophan Shrestha <hello@yourdomain.com>". Defaults to onboarding@resend.dev.
CONTACT_FROM=
